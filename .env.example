# LabelSure Environment Configuration Template

# Vision Provider configuration (openai | tesseract | mock)
# Note: mock is permitted ONLY when LABELSURE_MODE=demo
LABELSURE_MODE=production
VISION_PROVIDER=tesseract
OCR_PROVIDER=tesseract
VISION_MODEL=gpt-4o-mini

# Local Tesseract OCR Configuration (Optional custom executable path)
# If not set, system PATH and standard installation paths are automatically checked
# Example for Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Product & Barcode Enrichment Provider (openai | mock)
PRODUCT_ENRICHMENT_PROVIDER=openai
PRODUCT_ENRICHMENT_MODEL=gpt-4o-mini

# OpenAI API key for primary Vision and AI Enrichment
